<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- El oído: el audio se procesa en el teléfono y nunca sale de él -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Supabase: eventos, alertas y latido. Debug lo trae solo; sin esto, release no tiene red -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- La llamada de emergencia directa al primer contacto -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Para encontrar en la agenda la fila de llamada de WhatsApp del contacto -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Para volver al frente sola cuando termina la llamada de WhatsApp -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- «¿Está bien?» vibra además de sonar: para quien oye poco -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Sin internet no se intenta WhatsApp: la llamada sale directo por la red de teléfono -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Que la app no se muera: servicio en primer plano de tipo micrófono (Guardia.kt) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- El teléfono de mesa es dedicado: se le pide salir de la optimización de batería -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <application
        android:label="Presente"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <service
            android:name=".Guardia"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <!-- La llamada de emergencia sale primero por WhatsApp -->
        <package android:name="com.whatsapp" />
        <!-- El reconocimiento de voz que escucha «sí» o «no» -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
