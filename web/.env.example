# Variables de entorno de la web. Copiar a .env.local y rellenar.
# Ningún valor de aquí es real: son ejemplos para que no se cuele nada por accidente.

# ─── Supabase ──────────────────────────────────────────────────────────────────────────────
# URL pública del proyecto Supabase (la misma para llaves pública y secreta).
NEXT_PUBLIC_SUPABASE_URL=https://XXXX.supabase.co

# Llave pública (anon). Se expone al navegador; solo puede ejecutar familia_casa y familia_atender.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...anon...

# Llave secreta de servicio. SOLO para rutas del servidor (webhook, vigilante). Nunca al navegador.
SUPABASE_SECRET_KEY=eyJhbGciOi...service_role...

# ─── WhatsApp / Kapso ──────────────────────────────────────────────────────────────────────
# Número del negocio de Kapso (solo dígitos, con código de país). Es el que abre wa.me en la
# pantalla de bienvenida; NO es el teléfono del usuario.
NEXT_PUBLIC_WHATSAPP_NUMERO=580000000000

# X-API-Key de Kapso. Se usa en el servidor para mandar mensajes por WhatsApp.
KAPSO_API_KEY=kapso_sk_...

# Phone Number ID de Meta (el que da Kapso para apuntar los POST de /messages).
KAPSO_PHONE_NUMBER_ID=1234567890

# Secreto para validar el HMAC-SHA256 que Kapso manda en X-Webhook-Signature.
KAPSO_WEBHOOK_SECRET=whsec_...

# ─── Telegram ────────────────────────────────────────────────────────────────────────────────
# Token del bot de Telegram que da @BotFather. Se usa en el servidor para mandar mensajes.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Secreto para validar el header X-Telegram-Bot-Api-Secret-Token del webhook.
# Se pasa a setWebhook como secret_token. Generar con `openssl rand -hex 32` o similar.
TELEGRAM_WEBHOOK_SECRET=cambia-este-secreto-por-uno-aleatorio-largo

# Usuario del bot de Telegram (sin @). Se usa en la web para armar el enlace t.me/<usuario>.
NEXT_PUBLIC_TELEGRAM_BOT=mi_bot_de_avisos

# ─── URL base pública ──────────────────────────────────────────────────────────────────────
# Origen canónico de la web (sin trailing slash). Se usa para armar los enlaces de los avisos.
# Si falta, se deriva del origen del request, pero conviene fijarla para que los enlaces sean
# estables aunque cambie el host del servidor.
NEXT_PUBLIC_URL_BASE=https://ejemplo.vercel.app

# ─── Vigilante (cron) ──────────────────────────────────────────────────────────────────────
# Secreto que debe mandar el cron al llamar GET /api/vigilar. Bearer o ?secreto=.
# Generar con `openssl rand -hex 32` o similar.
CRON_SECRET=cambia-este-secreto-por-uno-aleatorio-largo
